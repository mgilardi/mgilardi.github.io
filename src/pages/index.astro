---
import Base from '../layouts/Base.astro';
import Spotlight from '../components/Spotlight.astro';
import { groups, links, builtAt } from '../data/projects';
import { getPosts, formatDate } from '../data/posts';

const name = 'Michael Gilardi';
const description =
  'Full-stack senior software engineer with over a decade of experience. Mac apps, Minecraft plugins, Payload CMS plugins and science tools.';
const updated = builtAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Phoenix' });
const year = new Date().getFullYear();
const posts = await getPosts();
---

<Base title={name} description={description}>
  <header class="site-header">
    <div class="wrap">
      <div class="intro">
        <img class="headshot" src="/michael.webp" width="160" height="160" alt="Michael smiling, arms crossed, in a black T-shirt" />
        <h1>{name}</h1>
      </div>
      <div class="lede">
        <p>
          Hey there! I’m Michael Gilardi — a full-stack senior software engineer with over a decade
          of experience. Basically, that means that I like to solve extremely complex problems and
          throw myself down deep rabbit holes for fun.
        </p>
        <p>
          I spend the majority of my days making technology do things, and my nights wondering why
          things do what they do. I’m big into coding, genealogy, reptiles… and whatever else has
          caught my attention this month.
        </p>
        <p>
          You might even say that I have a bit of a habit of turning simple questions into
          elaborate projects. And occasionally, they’re even useful!
        </p>
      </div>
      <nav aria-label="Elsewhere">
        <ul class="links">
          {links.map((l) => (
            <li>{l.url ? <a href={l.url} rel="me">{l.label}</a> : <span>{l.label}</span>}</li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <div class="wrap">
      <Spotlight />

      {posts.length > 0 && (
        <section class="writing" id="writing" aria-labelledby="writing-title">
          <div class="group-head">
            <h2 id="writing-title">Writing</h2>
            <p class="more"><a href="/rss.xml">RSS feed</a></p>
          </div>
          <ol class="posts">
            {posts.map((p) => (
              <li>
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
                <div>
                  <h3>
                    <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                    {p.data.draft && <span class="draft-badge">Draft</span>}
                  </h3>
                  <p>{p.data.summary}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <nav class="toc" aria-label="Projects">
        <h2 class="visually-hidden">Projects</h2>
        <ul>
          {groups.map((g) => (
            <li><a href={`#${g.id}`}>{g.title} <span class="count">{g.projects.length}</span></a></li>
          ))}
        </ul>
      </nav>

      {groups.map((g) => (
        <section class="group" id={g.id} aria-labelledby={`${g.id}-title`}>
          <div class="group-head">
            <h2 id={`${g.id}-title`}>{g.title}</h2>
            <p>{g.intro}</p>
            {g.more && <p class="more"><a href={g.more.url}>{g.more.label}</a></p>}
          </div>
          <ul class="cards">
            {g.projects.map((p) => (
              <li class="card" data-private={p.private ? 'true' : undefined}>
                <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
                <p>{p.description}</p>
                {p.facts.length > 0 && (
                  <ul class="facts" aria-label="Details">
                    {p.facts.map((f) => <li>{f}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>© {year} {name}. Built with Astro, hosted on GitHub Pages. No tracking, no cookies.</p>
      <p>Projects are listed from GitHub automatically, plus a few private ones that aren't released yet. Last updated <time datetime={builtAt.toISOString()}>{updated}</time>.</p>
      <p><a href="https://github.com/mgilardi/mgilardi.github.io">Source for this site</a></p>
    </div>
  </footer>
</Base>
