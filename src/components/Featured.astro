    --co-ink: #4c312c;
    --co-ink-soft: #5e423c;
    --co-bg: #fbf8f2;
    --co-card: #ffffff;
    --co-orange: #cf8137;
    --co-pink: #e48185;
    --co-line: #e8dccd;
    margin: 2.5rem 0 0;
    background: var(--co-bg);
    color: var(--co-ink);
    border: 1px solid var(--co-line);
    border-radius: 14px;
    position: relative;
    overflow: hidden;
  }
  .co::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: linear-gradient(90deg, var(--co-orange), var(--co-pink));
  }
  @media (prefers-color-scheme: dark) {
    .co {
      --co-ink: #f3e9df;
      --co-ink-soft: #dccbbd;
      --co-bg: #2a1e1b;
