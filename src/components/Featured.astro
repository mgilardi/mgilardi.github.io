  }
  .co-inner { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .co-eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
